# --- Core LLM (required for chat/intent/RAG answers) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Weather module ---
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Mandi price module ---
# Free key from https://data.gov.in (resource: Agmarknet daily prices)
DATA_GOV_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Optional broader-search retrievers (used if present, else DuckDuckGo/Wikipedia fallback) ---
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- Optional cloud vector DB (else local FAISS index is used) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=agribot-knowledge

# --- Misc ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
